{
    "rewrites": [
        {
            "source": "/zyro",
            "destination": "https://zyro-theta.vercel.app/"
        },
        {
            "source": "/zyro/:match*",
            "destination": "https://zyro-theta.vercel.app/:match*"
        },
        {
            "source": "/windex/:match*",
            "destination": "https://windex-navy.vercel.app/:match*"
        },
        {
            "source": "/((?!zyro|windex|static|api).*)",
            "destination": "/index.html"
        }
    ]
}